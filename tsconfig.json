{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2022",
    "lib": ["ES2022", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    /* Strictness — relaxed for recovered source (matches reference project) */
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,

    /* Path aliases — Bun resolves `from 'src/...'` as root-relative */
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"],
      // Native-module facades resolve to source, as in the official build (its sourcemap
      // lists ../vendor/*-src/index.ts and ../src/native-ts/color-diff/index.ts, not node_modules).
      "color-diff-napi": ["./src/native-ts/color-diff/index.ts"],
      "modifiers-napi": ["./vendor/modifiers-napi-src/index.ts"],
      "audio-capture-napi": ["./vendor/audio-capture-src/index.ts"],
      "image-processor-napi": ["./vendor/image-processor-src/index.ts"],
      "url-handler-napi": ["./vendor/url-handler-src/index.ts"]
    },

    /* Types */
    "types": ["bun-types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
